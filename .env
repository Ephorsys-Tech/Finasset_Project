# Finasset Wealth Environment Configuration

# Database: MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/finasset_wealth?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://finasset_user:FinassetAtlas2026@cluster0.mongodb.net/finasset_wealth?retryWrites=true&w=majority

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=finasset_access_token_secret_super_secure_key_2026_xyz
JWT_REFRESH_SECRET=finasset_refresh_token_secret_super_secure_key_2026_abc
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Admin Bootstrap Credentials (Used during setup/seed)
INITIAL_ADMIN_EMAIL=admin@finassetwealth.com
INITIAL_ADMIN_PASSWORD=Finasset@Admin2026!
INITIAL_ADMIN_NAME="Finasset Chief Administrator"

# Admin Notifications
ADMIN_NOTIFICATION_EMAIL=info@finassetwealth.com

# SMTP Configuration (Optional: for sending notifications & password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Finasset Wealth <noreply@finassetwealth.com>"

# Market Data & News Providers (Optional: defaults to curated live/cached financial indicators)
MARKET_DATA_API_KEY=
NEWS_API_KEY=

# Cloudinary Digital Asset Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
